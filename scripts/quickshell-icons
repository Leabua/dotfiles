#!/usr/bin/env python3
"""Build the Quickshell icon theme: minimalBar's line icons, inked in the wallpaper accent.

Matugen runs this after writing ~/.config/gtk-3.0/quickshell-colors.css. File, folder,
device and toolbar icons are drawn here; everything else falls through to Papirus-Dark.

Thunar picks the first icon name the theme chain knows, so a generic "image-x-generic"
never beats Papirus's "image-jpeg". Every Papirus name for a file type, folder or drive
is therefore linked to one of the glyphs below.
"""

import os
import re
import shutil
import sys
from pathlib import Path

HOME = Path.home()
COLORS = HOME / ".config/gtk-3.0/quickshell-colors.css"
THEME = HOME / ".local/share/icons/Quickshell"
PAPIRUS = Path("/run/current-system/sw/share/icons/Papirus-Dark")

# ------- strokes --------
# small matches MenuIcon.qml (1.7 on a 24 grid); large thins out so 64px grid icons stay light
SIZES = {"small": 1.7, "large": 1.05}
# ink tiers, same as the menus: glyph full, the page around it one step back, folders washed
PAGE_ALPHA = {"small": 0.7, "large": 0.55}
WASH_ALPHA = 0.14

# ------- shapes (24 grid, round caps / joins, like MenuIcon.qml) --------
PAGE = '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z"/><path d="M14 3v4a2 2 0 0 0 2 2h4"/>'
FOLDER = "M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"

# glyph that sits inside a page (lower two thirds)
FILE_GLYPHS = {
    "file": "",
    "text": '<path d="M8 13h8M8 17h5"/>',
    "document": '<path d="M9 12.5v-1h6v1M12 11.5v6.5M11 18h2"/>',
    "pdf": '<path d="M8 11h2M8 14h8M8 17h8"/>',
    "image": '<circle cx="10" cy="12.5" r="1.5"/><path d="m17 18-2.8-2.8a1.5 1.5 0 0 0-2.1 0L8 19.3"/>',
    "video": '<path d="m10 11.5 5 3-5 3Z"/>',
    "audio": '<circle cx="10" cy="17" r="1.8"/><path d="M11.8 17v-6l3.2 1.5"/>',
    "archive": '<path d="M11 4h.01M13 6h.01M11 8h.01M13 10h.01"/><rect x="10" y="13" width="4" height="5" rx="1"/>',
    "spreadsheet": '<rect x="8" y="12" width="8" height="6.5" rx="1"/><path d="M12 12v6.5M8 15.2h8"/>',
    "presentation": '<path d="M8.5 18v-2.5M12 18v-6M15.5 18v-4"/>',
    "code": '<path d="m10 12.5-2 2 2 2M14 12.5l2 2-2 2"/>',
    "executable": '<path d="m8.5 12.5 2.5 2.25-2.5 2.25M12.5 17.5h3"/>',
    "font": '<path d="m9 18 3-7 3 7M10.3 15.5h3.4"/>',
}

# glyph inside a folder's body
FOLDER_GLYPHS = {
    "folder": "",
    "home": '<path d="M9.5 16.5v-3l2.5-2 2.5 2v3Z"/>',
    "desktop": '<rect x="9" y="10.5" width="6" height="4.5" rx=".8"/><path d="M12 15v1.8M10.5 16.8h3"/>',
    "documents": '<path d="M9 12h6M9 15.5h4"/>',
    "download": '<path d="M12 10.5v6m-2.5-2.5 2.5 2.5 2.5-2.5"/>',
    "music": '<circle cx="10.5" cy="16" r="1.5"/><path d="M12 16v-5l2.5 1.2"/>',
    "pictures": '<circle cx="10" cy="11.8" r="1"/><path d="m8 17 3-2.8 1.8 1.6 1.4-1.2L16 17"/>',
    "videos": '<path d="m10.5 11 4 2.5-4 2.5Z"/>',
    "code": '<path d="m10 11.5-2 2 2 2M14 11.5l2 2-2 2"/>',
    "remote": '<circle cx="12" cy="13.5" r="3"/><path d="M9 13.5h6M12 10.5c1.2 1.6 1.2 4.4 0 6c-1.2-1.6-1.2-4.4 0-6"/>',
}

# stand-alone line icons (sidebar places, devices, toolbar actions); "wash" fills the outline
STANDALONE = {
    "trash": ('<path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7"/>', ""),
    "trash-full": ('<path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7"/>', '<path d="M5 6l1 15h12l1-15Z"/>'),
    "computer": ('<rect x="3" y="3" width="18" height="13" rx="2"/><path d="M12 16v5m-5 0h10"/>', ""),
    "drive": ('<rect x="3" y="13" width="18" height="8" rx="2"/><path d="M5.5 13 8 4h8l2.5 9M7 17h.01M10.5 17h.01"/>', ""),
    "removable": ('<rect x="6" y="9" width="12" height="13" rx="2"/><path d="M8.5 9V3h7v6M10.5 5.5v1M13.5 5.5v1"/>', ""),
    "disc": ('<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/>', ""),
    "network": ('<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3"/>', ""),
    "recent": ('<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>', ""),
    "bookmark": ('<path d="M18 21 12 17 6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2Z"/>', ""),
    # toolbar, the same strokes as the bar's popup buttons
    "back": ('<path d="M19 12H5m6-6-6 6 6 6"/>', ""),
    "forward": ('<path d="M5 12h14m-6-6 6 6-6 6"/>', ""),
    "up": ('<path d="M12 19V5m-6 6 6-6 6 6"/>', ""),
    "home": ('<path d="M4 10.5 12 4l8 6.5V19a2 2 0 0 1-2 2h-3.5v-6h-5v6H6a2 2 0 0 1-2-2Z"/>', ""),
    "search": ('<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/>', ""),
    "menu": ('<path d="M4 7h16M4 12h16M4 17h16"/>', ""),
    "reload": ('<path d="M3 10a9 9 0 1 1 1 7M3 4v6h6"/>', ""),
    "grid": ('<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>', ""),
    "list": ('<path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01"/>', ""),
    "compact": ('<path d="M3 6h7M3 12h7M3 18h7M14 6h7M14 12h7M14 18h7"/>', ""),
    "close": ('<path d="m6 6 12 12M18 6 6 18"/>', ""),
    "eject": ('<path d="M12 5 5 14h14Z"/><path d="M5 19h14"/>', ""),
    "new-tab": ('<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M12 8v8M8 12h8"/>', ""),
}

# ------- names --------
# fixed names, beyond what's discovered in Papirus; GTK and Thunar ask for these directly
EXTRA_NAMES = {
    "Places": {
        "folder": "folder", "folder-open": "folder", "inode-directory": "folder",
        "user-home": "folder-home", "user-desktop": "folder-desktop",
        "folder-documents": "folder-documents", "folder-download": "folder-download",
        "folder-music": "folder-music", "folder-pictures": "folder-pictures",
        "folder-videos": "folder-videos", "folder-remote": "folder-remote",
        "user-trash": "trash", "user-trash-full": "trash-full",
        "network-workgroup": "network", "network-server": "network",
        "user-bookmarks": "bookmark", "document-open-recent": "recent",
    },
    "Devices": {
        "computer": "computer", "drive-harddisk": "drive", "drive-harddisk-root": "drive",
        "drive-harddisk-system": "drive", "drive-removable-media": "removable",
        "media-removable": "removable", "drive-optical": "disc", "media-optical": "disc",
    },
    "MimeTypes": {
        "unknown": "file", "application-octet-stream": "file", "text-x-generic": "file-text",
        "text-plain": "file-text", "image-x-generic": "file-image", "video-x-generic": "file-video",
        "audio-x-generic": "file-audio", "package-x-generic": "file-archive",
        "application-x-executable": "file-executable", "font-x-generic": "file-font",
        "x-office-document": "file-document", "x-office-spreadsheet": "file-spreadsheet",
        "x-office-presentation": "file-presentation", "application-pdf": "file-pdf",
        "text-x-script": "file-code",
    },
    # non-symbolic names only: the toolbar draws these with symbolic icons switched off
    "Actions": {
        "go-previous": "back", "go-next": "forward", "go-up": "up", "go-home": "home",
        "edit-find": "search", "system-search": "search", "open-menu": "menu",
        "view-refresh": "reload", "view-grid": "grid", "view-list": "list",
        "view-list-details": "list", "view-list-icons": "grid", "view-compact": "compact",
        "view-list-compact": "compact", "window-close": "close", "tab-close": "close",
        "media-eject": "eject", "tab-new": "new-tab",
    },
}

# first match wins; tested against Papirus's mimetype names
MIME_RULES = [
    ("file-pdf", r"pdf|epub|mobipocket|fictionbook|djvu|postscript|x-dvi|oxps|xps|comicbook|x-cb[rz7t]"),
    ("file-image", r"^image-|x-office-drawing|illustrator|photoshop|x-xcf|x-krita|vnd\.adobe"),
    ("file-video", r"^video-|matroska|realmedia|x-mxf|x-flash-video"),
    ("file-audio", r"^audio-|application-ogg|x-musescore|midi"),
    ("file-font", r"^font-|x-font|woff|truetype|opentype"),
    ("file-archive", r"zip|tar|rar|7z|compress|archive|gzip|bzip|xz|zstd|lzma|lzip|lz4|lzo|cpio|x-ace|x-arj|x-lha|squashfs|x-deb|x-rpm|redhat-package|debian-package|x-apk|x-xar|java-archive|x-arc\b|x-cabinet|x-compressed"),
    ("disc", r"iso|cd-image|disk-image|raw-disk|diskimage|x-vmdk|x-qemu|x-vdi"),
    ("file-spreadsheet", r"spreadsheet|sheet|excel|csv|calc|gnumeric|tab-separated|x-ods|numbers"),
    ("file-presentation", r"presentation|powerpoint|slideshow|impress|keynote|x-odp"),
    ("file-document", r"wordprocessing|msword|opendocument\.text|rtf|x-office-document|abiword|x-mswrite|x-hwp|hwpx|x-iwork-pages|vnd\.ms-word|x-odt"),
    ("file-executable", r"x-executable|x-sharedlib|ms-dos-executable|x-msi|msdownload|appimage|x-object|x-elf|x-desktop|x-mach"),
    ("file-text", r"^text-(plain|x-generic|x-readme|x-log|x-changelog|x-copying|x-authors|x-install|x-credits|x-nfo|x-license)$"),
    ("file-code", r"^text-|json|javascript|typescript|\+xml|-xml$|xml-|shellscript|x-sh$|x-csh|python|perl|php|ruby|toml|yaml|sql|java|dart|lua|rust|x-go|wasm|ipynb|x-asp|x-m4|x-awk|x-tcl|x-ms-shortcut|x-sqlite|x-perl|x-ruby|x-r$|julia|kotlin|scala|swift|x-nix|x-make"),
]

PLACE_RULES = [
    ("trash-full", r"trash.*full|trashcan_full"),
    ("trash", r"trash"),
    ("network", r"^network|gtk-network|folder-network|knetattach|folder-cloud|folder-sync"),
    ("folder-remote", r"folder-remote"),
    ("folder-home", r"home"),
    ("folder-desktop", r"desktop"),
    ("folder-download", r"download|torrent"),
    ("folder-documents", r"document|folder-text|folder-txt|wordprocessing|folder-notes|folder-books"),
    ("folder-music", r"music|sound"),
    ("folder-pictures", r"picture|image|photo|camera"),
    ("folder-videos", r"video"),
    ("folder-code", r"code|development|projects|git|script|html|java|repository|folder-docker"),
    ("bookmark", r"^user-bookmarks$|^bookmark|stock_bookmark"),
    ("folder", r"folder|directory|stock_open|inode-"),
]

DEVICE_RULES = [
    ("disc", r"optical|cdrom|dvd|blu-?ray"),
    ("removable", r"removable|usb|flash|memory-card|sd-card|media-flash"),
    ("drive", r"^drive-|harddisk"),
    ("computer", r"^computer"),
]


def read_ink() -> str:
    try:
        css = COLORS.read_text()
    except OSError:
        sys.exit(f"quickshell-icons: no palette at {COLORS}; run matugen first")
    match = re.search(r"@define-color\s+qs_primary\s+(#[0-9a-fA-F]{6})", css)
    if not match:
        sys.exit(f"quickshell-icons: qs_primary missing from {COLORS}")
    return match.group(1)


def svg(ink: str, stroke: float, body: str) -> str:
    return (
        '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" '
        f'fill="none" stroke="{ink}" stroke-width="{stroke}" stroke-linecap="round" '
        f'stroke-linejoin="round">{body}</svg>\n'
    )


def glyphs(ink: str, size: str) -> dict[str, str]:
    stroke = SIZES[size]
    out = {}
    for name, glyph in FILE_GLYPHS.items():
        page = f'<g stroke-opacity="{PAGE_ALPHA[size]}">{PAGE}</g>'
        out["file" if name == "file" else f"file-{name}"] = svg(ink, stroke, page + glyph)
    for name, glyph in FOLDER_GLYPHS.items():
        body = (
            f'<path d="{FOLDER}" fill="{ink}" fill-opacity="{WASH_ALPHA}" stroke="none"/>'
            f'<path d="{FOLDER}"/>' + glyph
        )
        out["folder" if name == "folder" else f"folder-{name}"] = svg(ink, stroke, body)
    for name, (lines, wash) in STANDALONE.items():
        fill = wash.replace("<path ", f'<path fill="{ink}" fill-opacity="{WASH_ALPHA}" stroke="none" ') if wash else ""
        out[name] = svg(ink, stroke, fill + lines)
    return out


def papirus_names(context: str) -> set[str]:
    names = set()
    for size_dir in PAPIRUS.glob("*x*"):
        for icon in (size_dir / context).glob("*.svg"):
            if not icon.stem.endswith("-symbolic"):
                names.add(icon.stem)
    return names


def classify(name: str, rules: list[tuple[str, str]]) -> str | None:
    for target, pattern in rules:
        if re.search(pattern, name):
            return target
    return None


def mapping() -> dict[str, dict[str, str]]:
    names = {context: dict(extra) for context, extra in EXTRA_NAMES.items()}
    for name in papirus_names("mimetypes"):
        names["MimeTypes"].setdefault(name, classify(name, MIME_RULES) or "file")
    for name in papirus_names("places"):
        target = classify(name, PLACE_RULES)
        if target:
            names["Places"].setdefault(name, target)
    for name in papirus_names("devices"):
        target = classify(name, DEVICE_RULES)
        if target:
            names["Devices"].setdefault(name, target)
    return names


def index_theme(contexts: list[str]) -> str:
    dirs = [f"{size}/{context.lower()}" for size in SIZES for context in contexts]
    lines = [
        "[Icon Theme]",
        "Name=Quickshell",
        "Comment=minimalBar line icons inked in the wallpaper accent; Papirus Dark for the rest",
        "Inherits=Papirus-Dark,Adwaita,hicolor",
        f"Directories={','.join(dirs)}",
        "",
    ]
    for directory in dirs:
        size, context = directory.split("/")
        low, high, nominal = (8, 40, 24) if size == "small" else (41, 512, 64)
        context_name = next(c for c in contexts if c.lower() == context)
        lines += [
            f"[{directory}]",
            f"Size={nominal}",
            "Type=Scalable",
            f"MinSize={low}",
            f"MaxSize={high}",
            f"Context={context_name}",
            "",
        ]
    return "\n".join(lines)


def build() -> None:
    ink = read_ink()
    names = mapping()
    staging = THEME.with_name(THEME.name + ".new")
    shutil.rmtree(staging, ignore_errors=True)

    for size in SIZES:
        drawn = glyphs(ink, size)
        for context, table in names.items():
            directory = staging / size / context.lower()
            directory.mkdir(parents=True)
            for name, target in table.items():
                (directory / f"{name}.svg").write_text(drawn[target])

    (staging / "index.theme").write_text(index_theme(list(names)))

    # swap in one step so GTK never scans a half-written theme
    old = THEME.with_name(THEME.name + ".old")
    shutil.rmtree(old, ignore_errors=True)
    if THEME.is_symlink():
        THEME.unlink()
    elif THEME.exists():
        THEME.rename(old)
    staging.rename(THEME)
    shutil.rmtree(old, ignore_errors=True)
    os.utime(THEME)


if __name__ == "__main__":
    build()
