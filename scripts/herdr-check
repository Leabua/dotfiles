#!/usr/bin/env python3
"""Check the stowed Herdr app config before it can break the window.

Catches what has bitten us:
  - a settings.json or layout naming a theme that isn't built in and has no
    themes/<name>.json committed (Herdr then refuses the whole layout, footer
    and all: "layouts/herdr-t3.json was not applied: theme ...")
  - a JSON file that doesn't parse
  - a mod that doesn't load (`herdr-app check`)

  herdr-check            config + mods (what the pre-commit hook runs)
  herdr-check --tests    also run the mods' check-*.cjs suites
  herdr-check --live     also ask the running window for its errors
"""
import json, os, subprocess, sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
HOME = REPO / "herdr-app/.config/herdr-app"
BUILTIN_THEMES = {"graphite", "ink", "moss", "paper"}
args = set(sys.argv[1:])
problems = []

def tracked(path: Path) -> bool:
    r = subprocess.run(["git", "-C", str(REPO), "ls-files", "--error-unmatch", str(path)], capture_output=True)
    return r.returncode == 0

def themes_named(node):
    if isinstance(node, dict):
        for k, v in node.items():
            if k == "theme" and isinstance(v, str):
                yield v
            else:
                yield from themes_named(v)
    elif isinstance(node, list):
        for v in node:
            yield from themes_named(v)

# Only the files git keeps: they are what a fresh `stow herdr-app` gets.
json_files = [p for p in [HOME / "settings.json", HOME / "keys.json", *sorted((HOME / "layouts").glob("*.json")),
                          *sorted((HOME / "themes").glob("*.json"))] if p.exists() and tracked(p)]
for p in json_files:
    rel = p.relative_to(HOME)
    try:
        data = json.loads(p.read_text())
    except json.JSONDecodeError as e:
        problems.append(f"{rel}: not valid JSON ({e})")
        continue
    if p.parent.name == "themes":
        continue
    for name in themes_named(data):
        theme = HOME / "themes" / f"{name}.json"
        if name in BUILTIN_THEMES:
            continue
        if not theme.exists():
            problems.append(f'{rel}: theme "{name}" is not built in ({", ".join(sorted(BUILTIN_THEMES))}) and themes/{name}.json is missing')
        elif not tracked(theme):
            problems.append(f'{rel}: theme "{name}" exists locally but themes/{name}.json is not committed (add it, and whitelist it in .gitignore)')

# Every layout the config uses must be committed too.
settings = HOME / "settings.json"
if settings.exists():
    try:
        layout = json.loads(settings.read_text()).get("layout")
        if layout and not tracked(HOME / "layouts" / f"{layout}.json") and layout not in {"main", "terminals", "win98"}:
            problems.append(f'settings.json: layout "{layout}" has no committed layouts/{layout}.json')
    except json.JSONDecodeError:
        pass

app = subprocess.run(["sh", "-c", "command -v herdr-app"], capture_output=True, text=True).stdout.strip()
mods = sorted(p for p in (HOME / "mods").iterdir() if p.is_dir() and tracked(p / "mod.json")) if (HOME / "mods").exists() else []
if app:
    for mod in mods:
        r = subprocess.run([app, "check", str(mod)], capture_output=True, text=True, timeout=60)
        if r.returncode != 0 or "check passed" not in r.stdout + r.stderr:
            problems.append(f"mods/{mod.name}: herdr-app check failed:\n    " + (r.stdout + r.stderr).strip().replace("\n", "\n    "))
else:
    print("herdr-check: herdr-app not on PATH, skipping mod loading", file=sys.stderr)

if "--tests" in args:
    for suite in sorted(HOME.glob("mods/*/check-*.cjs")):
        r = subprocess.run(["node", str(suite)], cwd=HOME, capture_output=True, text=True, timeout=300)
        if r.returncode != 0:
            first = next((l for l in (r.stdout + r.stderr).splitlines() if "Error" in l), "failed")
            problems.append(f"{suite.relative_to(HOME)}: {first.strip()}")

if "--live" in args and app:
    r = subprocess.run([app, "status"], capture_output=True, text=True, timeout=10)
    try:
        for err in json.loads(r.stdout).get("errors", []):
            problems.append(f"running window: {err.strip()}")
    except json.JSONDecodeError:
        print("herdr-check: no running window to ask", file=sys.stderr)

if problems:
    print("herdr-check found problems:", file=sys.stderr)
    for p in problems:
        print(f"  - {p}", file=sys.stderr)
    sys.exit(1)
print(f"herdr-check: ok ({len(json_files)} config files, {len(mods)} mods{', tests' if '--tests' in args else ''})")
