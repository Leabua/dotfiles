// Material You window-border colours -> regenerated by matugen on every wallpaper change
// (rotate_wallpaper.sh runs `matugen image`, which processes every template in config.toml).
// Included by niri/modules/looknfeel.kdl; same { tertiary, primary } stops as hyprborder.
layout {
    border {
        active-gradient from="#{{colors.tertiary.default.hex_stripped}}" to="#{{colors.primary.default.hex_stripped}}" angle=45
    }
}
