.DS_Store
Thumbs.db
*.swp
*~
*.pem
*.key
*.cert
id_*
*.env
credentials*
*.local
*.bak
__pycache__/
.cache/

# Environment files
.envrc
.env.local
.env.production
.env.development

# Certificate/keystore formats
*.p12
*.pfx
*.p7b
*.cer
*.crt
*.der

# VPN configs
*.ovpn

# Credential files
.netrc
.git-credentials
.npmrc
.yarnrc
.yarnrc.yml
.pypirc
.docker/config.json
.gcloud/
.aws/
.azure/

# OS files
Desktop.ini
*.lnk

# IDE/editor
.idea/
.vscode/
*.sublime-*
*.project
*.classpath

# Secrets/keys in other formats
*secret*
*password*
*.token
.claude/
# ...except the claude stow package: only its settings and scripts, never Claude's runtime state.
!claude/.claude/
claude/.claude/*
!claude/.claude/settings.json
!claude/.claude/scripts/

# Neovim runtime output.
nvim/.config/nvim/nvim.log

# hyprlock.conf's wallpaper path changes locally when wallpaper switches;
# it's still tracked, but marked skip-worktree so local edits don't show as diffs
# (see: git update-index --skip-worktree hypr/.config/hypr/hyprlock.conf)

# nix build output symlinks
result
result-*

# herdr runtime state (logs, agent socket, sessions) written into its stowed config dir
herdr/.config/herdr/*.log
herdr/.config/herdr/*.sock*
herdr/.config/herdr/session.json
herdr/.config/herdr/session-snapshots/
herdr/.config/herdr/.plugins.lock
