command = command -v zsh >/dev/null && exec zsh || exec bash

theme = cyberdream
# theme = Terafox

 
font-family = "Maple Mono NF"
# font-style = Normal
font-style = Normal
font-size = 14
font-feature = calt

# Plain-style italic glyphs -> rm the cursive letters
font-feature = cv33
font-feature = cv34
font-feature = cv35
font-feature = cv36
font-feature = cv37

# window
window-padding-y = 6
window-padding-x = 6
resize-overlay = never
background-opacity = 0.92
window-inherit-working-directory = true

# cursor
cursor-style = "block"
cursor-style-blink = false

shell-integration-features = no-cursor,ssh-env

window-decoration = false
confirm-close-surface = false
keybind = ctrl+enter=unbind
