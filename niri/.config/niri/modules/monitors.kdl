// -------------------------------
// --- monitors and workspaces ---
// -------------------------------

environment {
    GDK_SCALE "1"
}

output "eDP-1" {
    mode "1920x1080@60"
    position x=0 y=0
    scale 1.0
}

output "HDMI-A-1" {
    mode "1920x1080@60"
    position x=1920 y=0
    scale 1.0
}
