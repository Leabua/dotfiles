// ---------------------------
// --- My Default Programs ---
// ---------------------------
// Split into modules like hypr/.config/hypr; window management follows niri conventions.
// KDL has no variables, so the programs are inlined in bindings.kdl:
// BROWSER = zen-beta, FILEMANAGER = thunar, TERMINAL = ghostty

hotkey-overlay {
    skip-at-startup
}

// ---------------------
// --- Env Variables ---
// ---------------------

environment {
    XCURSOR_SIZE "20"
    XCURSOR_THEME "Bibata-Modern-Classic"
}

// --------------------
// --- Source Files ---
// --------------------

include "modules/autostart.kdl"
include "modules/bindings.kdl"
include "modules/inputs.kdl"
include "modules/looknfeel.kdl"
include "modules/monitors.kdl"
include "modules/tiling.kdl"
include "modules/utilities.kdl"
include "modules/windowrules.kdl"
