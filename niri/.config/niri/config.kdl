// ==========================================
// Leabua's Niri Configuration
// Optimized for independent dual-monitor workflow
// ==========================================

hotkey-overlay {
    skip-at-startup
}

// -------------------
// Environment
// -------------------

environment {
    XCURSOR_SIZE "20"
    XCURSOR_THEME "Bibata-Modern-Classic"
    GDK_SCALE "1"
    GTK_THEME "Adwaita:dark"
}

// -------------------
// Autostart
// -------------------
// Niri's session launcher manages graphical-session.target (including polkit).
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP" "XDG_SESSION_TYPE" "NIRI_SOCKET"
spawn-sh-at-startup "eval $(gnome-keyring-daemon --start --components=secrets) && systemctl --user import-environment GNOME_KEYRING_CONTROL SSH_AUTH_SOCK"
spawn-sh-at-startup "qs -p $HOME/.config/quickshell/minimalBar"
spawn-at-startup "nm-applet"
spawn-at-startup "awww-daemon"
spawn-sh-at-startup "for attempt in 1 2 3 4 5; do awww query >/dev/null 2>&1 && break; sleep 0.2; done; wallpaper=$(cat ~/.cache/awww_current_wallpaper 2>/dev/null); [ -f \"$wallpaper\" ] && awww img \"$wallpaper\" --transition-type fade"
spawn-sh-at-startup "hypridle -c $HOME/.config/niri/hypridle.conf"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-sh-at-startup "wl-paste --type image --watch $HOME/dotfiles/scripts/cliphist-export-live"

// -------------------
// Input Devices
// -------------------

input {
    keyboard {
        xkb {
            layout "us"
            options "caps:swapescape"
        }
        repeat-rate 60
        repeat-delay 300
        numlock
    }
    touchpad {
        // off
        natural-scroll
        scroll-factor 1.0
        tap
        dwt
    }
    mouse {
        // Leave natural-scroll off for standard mouse behavior
    }
    focus-follows-mouse
    warp-mouse-to-focus
}

// -------------------
// Monitors / Outputs
// -------------------
output "HDMI-A-1" {
    mode "1920x1080@60"
    position x=0 y=-1080
    scale 1.0
}
output "eDP-1" {
    mode "1920x1080@60"
    position x=0 y=0
    scale 1.0
}

// -------------------
// Window Decorations
// -------------------
window-rule {
    match is-focused=true
    opacity 1.0

    geometry-corner-radius 0
    clip-to-geometry true

    draw-border-with-background false // this solves the color issues on focused windows

    shadow {
      off
    }
    focus-ring {
      on
      width 2
      active-gradient from="#a6e3a1" to="#89b4fa" angle=45
    }
}
window-rule {
    match is-focused=false
    opacity 1.0

    geometry-corner-radius 0
    clip-to-geometry true

    shadow {
      off
    }
}

// -------------------
// Layout & Styling
// -------------------
layout {
    gaps 10
    center-focused-column "never"
    preset-column-widths {
        proportion 0.5
        proportion 1.0
    }
    preset-window-heights {
        proportion 0.5
        proportion 1.0
    }
    default-column-width { proportion 0.5; }
    border {
        off
    }
}


// -------------------
// Gestures
// -------------------
gestures {
    hot-corners {
        off
    }
}

// -------------------
// Cursor
// -------------------
cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 20
    hide-when-typing
    hide-after-inactive-ms 10000
}

// -------------------
// Animations
// -------------------
animations {
    // slowdown 1.0
}

// -------------------
// Keybindings
// -------------------
binds {
   // quickly mirror laptop to monitor using wl-mirror
    Mod+Ctrl+M { spawn "sh" "-c" "wl-mirror  eDP-1"; }

    // Same applications and minimalBar IPC targets as Hyprland.
    Mod+Return { spawn "ghostty"; }
    Mod+Shift+O { spawn "obsidian"; }
    Mod+Shift+F { spawn "thunar"; }
    Mod+B { spawn "zen-beta"; }
    Mod+Space { spawn-sh "qs -p $HOME/.config/quickshell/minimalBar ipc call launcher toggle"; }
    Mod+Alt+Space { spawn-sh "qs -p $HOME/.config/quickshell/minimalBar ipc call rightIsland toggle"; }
    Mod+N { spawn-sh "qs -p $HOME/.config/quickshell/minimalBar ipc call notifications toggle"; }
    Mod+C { spawn-sh "qs -p $HOME/.config/quickshell/minimalBar ipc call clipboard toggle"; }
    Mod+R { spawn-sh "qs -p $HOME/.config/quickshell/minimalBar ipc call reminders toggle"; }
    Mod+Shift+Space { spawn-sh "qs -p $HOME/.config/quickshell/minimalBar ipc call bar toggle"; }
    Mod+P { spawn-sh "~/dotfiles/scripts/rotate_wallpaper.sh"; }
    Mod+Ctrl+L { spawn "hyprlock"; }

    Print { spawn-sh "grim -g \"$(slurp)\" - | wl-copy && notify-send 'Screenshot' 'Selection copied to clipboard' -i clipboard"; }
    Mod+Print { spawn-sh "output=$(niri msg --json focused-output | jq -r '.name // empty'); [ -n \"$output\" ] && grim -o \"$output\" - | wl-copy && notify-send 'Screenshot' 'Monitor copied to clipboard' -i clipboard"; }

    // -- Audio Controls --
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // -- Brightness Controls --
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "brightnessctl -e4 -n2 set 5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl -e4 -n2 set 5%-"; }

    // -- Media Controls --
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }

    // -- Power Menu --
    XF86PowerOff allow-when-locked=true { spawn-sh "qs -p $HOME/.config/quickshell/minimalBar ipc call powerMenu toggle"; }

    // -- Core Window Management --
    Mod+W { close-window; }
    Mod+F { fullscreen-window; }
    Mod+O { toggle-window-floating; }
    Mod+Tab { toggle-overview; }
    Mod+Shift+Q { quit; }

    // -- Focus Navigation --
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }

    // -- Cross-Monitor Navigation --
    Mod+Shift+K { move-window-up; }
    Mod+Shift+J { move-window-down; }
    Mod+Ctrl+K  { focus-monitor-up; }
    Mod+Ctrl+J  { focus-monitor-down; }
    Mod+Ctrl+H  { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+Left { focus-monitor-left; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }

    // -- Move Windows / Modify Layout --
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Comma   { consume-window-into-column; }
    Mod+Period  { expel-window-from-column; }

    // -- Move Windows Across Monitors --
    Mod+Ctrl+Shift+K { move-window-to-monitor-up; }
    Mod+Ctrl+Shift+J { move-window-to-monitor-down; }
    Mod+Ctrl+Shift+H { move-window-to-monitor-left; }
    Mod+Ctrl+Shift+L { move-window-to-monitor-right; }

    // -- Resize --
    Mod+Minus       { set-column-width "-100"; }
    Mod+Equal       { set-column-width "+100"; }
    Mod+Shift+Minus { set-window-height "-100"; }
    Mod+Shift+Equal { set-window-height "+100"; }

    // -- Preset Layout Toggles --
    Mod+T       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Shift+T { switch-preset-window-height; }

    // -- Workspace Switching --
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    // -- Move Active Window to Workspace --
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Shift+0 { move-window-to-workspace 10; }

    // -- Send Window to Workspace (Silent) --
    Mod+Ctrl+Shift+1 { move-window-to-workspace 1 focus=false; }
    Mod+Ctrl+Shift+2 { move-window-to-workspace 2 focus=false; }
    Mod+Ctrl+Shift+3 { move-window-to-workspace 3 focus=false; }
    Mod+Ctrl+Shift+4 { move-window-to-workspace 4 focus=false; }
    Mod+Ctrl+Shift+5 { move-window-to-workspace 5 focus=false; }
    Mod+Ctrl+Shift+6 { move-window-to-workspace 6 focus=false; }
    Mod+Ctrl+Shift+7 { move-window-to-workspace 7 focus=false; }
    Mod+Ctrl+Shift+8 { move-window-to-workspace 8 focus=false; }
    Mod+Ctrl+Shift+9 { move-window-to-workspace 9 focus=false; }
    Mod+Ctrl+Shift+0 { move-window-to-workspace 10 focus=false; }
}


// -------------------
// Window Rules
// -------------------
window-rule {
    match app-id="com.mitchellh.ghostty" title="^wiremix-term$"
    open-floating true
}
window-rule {
    match app-id="com.mitchellh.ghostty" title="^bluetui-term$"
    open-floating true
}
window-rule {
    match app-id="com.mitchellh.ghostty" title="^impala-term$"
    open-floating true
}
window-rule {
    match app-id="com.mitchellh.ghostty" title="^sysmenu-tui$"
    open-floating true
}
window-rule {
    match app-id="^localsend$"
    open-floating true
}
window-rule {
    match app-id="^org.gnome.NautilusPreviewer$"
    open-floating true
}
// Prevent Apple Music PWA from stealing focus on launch
window-rule {
    match app-id="^chrome-blgdilankhbcpipclgpdndahbehalgkh-Default$"
    open-focused false
}

