// ==========================================
// Leabua's Niri Configuration
// Optimized for independent dual-monitor workflow
// ==========================================

hotkey-overlay {
    skip-at-startup
}

// -------------------
// Environment
// -------------------

environment {
    XCURSOR_SIZE "20"
    XCURSOR_THEME "Bibata-Modern-Ice"
    GDK_SCALE "1"
}

// -------------------
// Autostart
// -------------------
spawn-sh-at-startup "ssh-add ~/.ssh/id_ed25519"
spawn-at-startup "gnome-keyring-daemon" "--start" "--components=ssh,secrets,pkcs11"
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"
spawn-at-startup "nm-applet"
// wallpaper daemon — same as Hyprland's autostart.lua
spawn-at-startup "awww-daemon"
spawn-sh-at-startup "awww img $(cat ~/.cache/awww_current_wallpaper 2>/dev/null) --transition-type fade"
spawn-at-startup "hypridle"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
// hyprpolkitagent is started system-wide via a systemd user unit
// (WantedBy=graphical-session.target), not from here — see nixos/configuration.nix
spawn-at-startup "noctalia"

// -------------------
// Input Devices
// -------------------

input {
    keyboard {
        xkb {
            layout "us"
            options "caps:swapescape"
        }
        repeat-rate 60
        repeat-delay 300
        numlock
    }
    touchpad {
        // off
        natural-scroll
        scroll-factor 1.0
        tap
        dwt
    }
    mouse {
        // Leave natural-scroll off for standard mouse behavior
    }
    focus-follows-mouse
    warp-mouse-to-focus
}

// -------------------
// Monitors / Outputs
// -------------------
output "HDMI-A-1" {
    mode "1920x1080@60"
    position x=0 y=-1080
    scale 1.0
}
output "eDP-1" {
    mode "1920x1080@60"
    position x=0 y=0
    scale 1.0
}

// -------------------
// Window Decorations
// -------------------
window-rule {
    match is-focused=true
    opacity 1.0

    geometry-corner-radius 0
    clip-to-geometry true

    draw-border-with-background false // this solves the color issues on focused windows

    background-effect {
      blur false
    }
    shadow {
      off
    }
    focus-ring {
      on
      width 2
      active-gradient from="#a6e3a1" to="#89b4fa" angle=45
    }
}
window-rule {
    match is-focused=false
    opacity 1.0

    geometry-corner-radius 0
    clip-to-geometry true

    background-effect {
      blur false
    }
    shadow {
      off
    }
}

// -------------------
// Layout & Styling
// -------------------
layout {
    gaps 10
    center-focused-column "never"
    preset-column-widths {
        proportion 0.5
        proportion 1.0
    }
    preset-window-heights {
        proportion 0.5
        proportion 1.0
    }
    default-column-width { proportion 0.5; }
    border {
        off
    }
}


// -------------------
// Gestures
// -------------------
gestures {
    hot-corners {
        off
    }
}

// -------------------
// Cursor
// -------------------
cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 20
    hide-when-typing
    hide-after-inactive-ms 10000
}

// -------------------
// Animations
// -------------------
animations {
    // slowdown 1.0
}

// -------------------
// Keybindings
// -------------------
binds {
   // quickly mirror laptop to monitor using wl-mirror
    Mod+Ctrl+M { spawn "sh" "-c" "wl-mirror  eDP-1"; }

    // -- Application Launchers -- (aligned with Hyprland: SUPER+Return / SUPER+SHIFT+O/F)
    Mod+Return { spawn "ghostty"; }
    Mod+Shift+O { spawn "obsidian"; }
    Mod+Shift+F { spawn "nautilus"; }
    Mod+B { spawn "zen-beta"; } // was Mod+Shift+B — changed to Mod+B to match Hyprland SUPER+B (BROWSER=zen-beta)

    // App launcher — noctalia (was quickshell onebarV2; Hyprland SUPER+SPACE)
    Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }

    // Control center — noctalia (was quickshell powerMenu; Hyprland SUPER+ALT+SPACE rightIsland)
    Mod+Alt+Space { spawn-sh "noctalia msg panel-toggle control-center"; }

    // Clipboard — noctalia (was qs clipboard on Mod+Shift+V/C; Hyprland SUPER+C)
    Mod+C { spawn-sh "noctalia msg panel-toggle clipboard"; }
    // keep old aliases for muscle memory
    Mod+Shift+C { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+Shift+V { spawn-sh "noctalia msg panel-toggle clipboard"; }

    // Wallpaper — cycle to next, same script Hyprland uses (was Mod+Shift+P, now Mod+P to match Hyprland SUPER+P)
    Mod+P { spawn-sh "~/dotfiles/scripts/rotate_wallpaper.sh"; }
    // keep old alias
    Mod+Shift+P { spawn-sh "~/dotfiles/scripts/rotate_wallpaper.sh"; }

    Mod+Shift+M { spawn-sh "chromium --app-id=blgdilankhbcpipclgpdndahbehalgkh"; }

    // Bar toggle — noctalia (was qs bar toggle on Mod+Shift+Return; Hyprland SUPER+SHIFT+SPACE)
    Mod+Shift+Space { spawn-sh "noctalia msg bar-toggle"; }
    // keep old alias
    Mod+Shift+Return { spawn-sh "noctalia msg bar-toggle"; }

    // Lockscreen — hyprlock implements ext-session-lock-v1, works under niri too
    // Hyprland is SUPER+CTRL+L; niri keeps Mod+Alt+L to avoid conflict with Mod+Ctrl+L focus-monitor-right (no Hyprland equivalent, left as is)
    Mod+Alt+L { spawn "hyprlock"; }

    // Settings — noctalia (was qs cycleBarLevel; Hyprland has no direct equivalent)
    Mod+Alt+C { spawn-sh "noctalia msg settings-toggle"; }

    // Notifications — noctalia has no dedicated notifications panel; control-center is closest (was qs notifications on Mod+Alt+N; Hyprland SUPER+N)
    Mod+N { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Alt+N { spawn-sh "noctalia msg panel-toggle control-center"; }

    // System monitor — onebarV2 engineRoom has no direct noctalia equivalent, mapped to control-center (no Hyprland equivalent, left as is)
    Mod+Alt+M { spawn-sh "noctalia msg panel-toggle control-center"; }

    Print { spawn-sh "grim -g \"$(slurp)\" - | satty --filename -"; }
    Mod+Print { spawn-sh "grim - | wl-copy && notify-send 'Screenshot' 'Monitor copied to clipboard' -i clipboard"; }

    // -- Audio Controls -- (kept wpctl to match Hyprland utilities.lua; noctalia alternative is `noctalia msg volume-up/down/mute`)
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // -- Brightness Controls --
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "brightnessctl -e4 -n2 set 5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl -e4 -n2 set 5%-"; }

    // -- Media Controls --
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }

    // -- Power Menu -- (was qs powerMenu; noctalia session menu; Hyprland XF86PowerOff -> qs powerMenu)
    XF86PowerOff allow-when-locked=false { spawn-sh "noctalia msg panel-toggle session"; }

    // -- Core Window Management --
    Mod+W { close-window; }
    Mod+F { fullscreen-window; }
    Mod+O { toggle-overview; }
    Mod+Shift+Q { quit; }

    // -- Focus Navigation --
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-workspace-up; }
    Mod+J { focus-workspace-down; }

    // -- Cross-Monitor Navigation --
    Mod+Shift+K { focus-monitor-up; }
    Mod+Shift+J { focus-monitor-down; }
    Mod+Ctrl+K  { focus-monitor-up; }
    Mod+Ctrl+J  { focus-monitor-down; }
    Mod+Ctrl+H  { focus-monitor-left; }
    Mod+Ctrl+L  { focus-monitor-right; }

    // -- Move Windows / Modify Layout --
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Comma   { consume-window-into-column; }
    Mod+Period  { expel-window-from-column; }

    // -- Move Windows Across Monitors --
    Mod+Ctrl+Shift+K { move-window-to-monitor-up; }
    Mod+Ctrl+Shift+J { move-window-to-monitor-down; }
    Mod+Ctrl+Shift+H { move-window-to-monitor-left; }
    Mod+Ctrl+Shift+L { move-window-to-monitor-right; }

    // -- Resize --
    Mod+Minus       { set-column-width "-100"; }
    Mod+Equal       { set-column-width "+100"; }
    Mod+Shift+Minus { set-window-height "-100"; }
    Mod+Shift+Equal { set-window-height "+100"; }

    // -- Preset Layout Toggles --
    Mod+R       { switch-preset-column-width; }
    Mod+T       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Shift+T { switch-preset-window-height; }

    // -- Workspace Switching --
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    // -- Move Active Window to Workspace --
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Shift+0 { move-window-to-workspace 10; }

    // -- Send Window to Workspace (Silent) --
    Mod+Ctrl+Shift+1 { move-window-to-workspace 1; }
    Mod+Ctrl+Shift+2 { move-window-to-workspace 2; }
    Mod+Ctrl+Shift+3 { move-window-to-workspace 3; }
    Mod+Ctrl+Shift+4 { move-window-to-workspace 4; }
    Mod+Ctrl+Shift+5 { move-window-to-workspace 5; }
    Mod+Ctrl+Shift+6 { move-window-to-workspace 6; }
    Mod+Ctrl+Shift+7 { move-window-to-workspace 7; }
    Mod+Ctrl+Shift+8 { move-window-to-workspace 8; }
    Mod+Ctrl+Shift+9 { move-window-to-workspace 9; }
    Mod+Ctrl+Shift+0 { move-window-to-workspace 10; }
}


// -------------------
// Window Rules
// -------------------
window-rule {
    match app-id="com.mitchellh.ghostty" title="^wiremix-term$"
    open-floating true
}
window-rule {
    match app-id="com.mitchellh.ghostty" title="^bluetui-term$"
    open-floating true
}
window-rule {
    match app-id="com.mitchellh.ghostty" title="^impala-term$"
    open-floating true
}
window-rule {
    match app-id="com.mitchellh.ghostty" title="^sysmenu-tui$"
    open-floating true
}
window-rule {
    match app-id="^localsend$"
    open-floating true
}
window-rule {
    match app-id="^org.gnome.NautilusPreviewer$"
    open-floating true
}
// Prevent Apple Music PWA from stealing focus on launch
window-rule {
    match app-id="^chrome-blgdilankhbcpipclgpdndahbehalgkh-Default$"
    open-focused false
}

