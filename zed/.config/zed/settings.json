{
  "cli_default_open_behavior": "existing_window",
  "cursor_blink": false,
  "relative_line_numbers": "enabled",
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Rosé Pine",
    "dark": "Terafox - blurred"
  },
  "languages": {
    "Nix": {
      "formatter": "language_server",
      "format_on_save": "on"
    }
  },
  "lsp": {
    "nixd": {
      "settings": {
        "nixd": {
          "nixpkgs": {
            "expr": "import (builtins.getFlake \"/home/leabua/dotfiles/nixos\").inputs.nixpkgs {}"
          },
          "formatting": {
            "command": ["nixfmt"]
          }
        }
      }
    }
  }
}
