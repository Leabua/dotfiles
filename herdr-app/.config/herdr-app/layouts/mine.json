{
  "id": "root",
  "cloned_from": {
    "name": "terminals",
    "version": "0.1.15"
  },
  "type": "column",
  "children": [
    {
      "id": "top",
      "type": "row",
      "size": {
        "px": 38
      },
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "terminals-bar"
          },
          "window_drag": true,
          "size": {
            "weight": 1
          }
        },
        {
          "id": "vimnav",
          "type": "block",
          "content": {
            "mod": "vimnav"
          },
          "size": {
            "px": 1
          }
        }
      ]
    },
    {
      "id": "main",
      "type": "block",
      "content": {
        "tab": "active",
        "pane": {
          "header": {
            "content": {
              "mod": "terminals-pane"
            },
            "height": 38
          },
          "background": "#17191c",
          "border": {
            "width": 1,
            "color": "#24272b"
          },
          "focus": {
            "width": 1,
            "color": "#33363b"
          },
          "radius": 12,
          "gap": 8,
          "lone": true
        }
      }
    }
  ],
  "background": "canvas",
  "padding": [
    6,
    6
  ],
  "gap": 8,
  "titlebar": "none",
  "traffic_lights": [
    16,
    18
  ],
  "terminal_padding": [
    6,
    6
  ]
}
